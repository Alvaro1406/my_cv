// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "security", "manage"]
}

model User {
  id          String        @id @default(uuid())
  username    String        @unique
  password    String
  firstName   String
  lastName    String
  email       String
  phoneNumber String
  image       String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  sessions    UserSession[]

  @@index([username])
  @@schema("security")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, token, expiresAt])
  @@schema("security")
}

/**
 * It will be applied in the future for better implementation and management of skills.
 */
/**
 * model Skills {
 * id                 String           @id @default(uuid())
 * name               String
 * level              Int
 * type               TypeSkills
 * technicalMasteryId String
 * technicalMastery   TechnicalMastery @relation(fields: [technicalMasteryId], references: [id])
 * createdAt          DateTime         @default(now())
 * updatedAt          DateTime         @updatedAt
 * @@index([name, type, createdAt])
 * @@schema("manage")
 * }
 */

/**
 * Technical Mastery
 */
model TechnicalMastery {
  id          String   @id @default(uuid())
  name        Json     @default("{}")
  description Json     @default("{}")
  /**
   * skills      Skills[]
   */
  tags        String[]
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name, createdAt])
  @@schema("manage")
}

/**
 * Soft Skills
 */
model SoftSkills {
  id          String   @id @default(uuid())
  name        Json     @default("{}")
  description Json     @default("{}")
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name, createdAt])
  @@schema("manage")
}

model Contact {
  id           String         @id @default(uuid())
  name         String
  email        String
  subject      String
  message      String
  unread       Boolean        @default(true)
  archived     Boolean        @default(false)
  important    Boolean        @default(false)
  favorite     Boolean        @default(false)
  notification Notifications?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([email, unread, archived, createdAt])
  @@schema("manage")
}

model Notifications {
  id          String   @id @default(uuid())
  title       String
  description String
  contact     Contact  @relation(fields: [contactId], references: [id])
  contactId   String   @unique
  unread      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([unread, createdAt])
  @@schema("manage")
}

enum TypeSkills {
  FrontEnd
  BackEnd
  Design
  Tools

  @@schema("manage")
}
